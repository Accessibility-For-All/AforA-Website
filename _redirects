# Cloudflare Pages redirects. One rule per line: <from> <to> <status>
#
# NOTE: Pages serves extensionless URLs natively and 308-redirects /foo.html -> /foo.
# So targets here are extensionless, and there must be NO alias whose name matches a
# target's basename (e.g. "/pricing -> /pricing.html" loops forever against the
# built-in 308). Pages already gives us /pricing for free — no alias needed.

# Legacy pages that were renamed or removed — keep their inbound links alive.
/wcag-checker.html           /websites          301
/demo.html                   /docmersion-demo   301
/vpat-acr.html               /reports           301
/accessibility-monitor.html  /websites#monitor  301

# Convenience aliases for print/collateral. Only where the alias differs from the
# target basename — anything else would collide with the built-in 308.
/demo      /book-demo          301
/privacy   /privacy-policy     301
/terms     /terms-of-service   301
